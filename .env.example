# Copy this file to a real env file (or set these as actual environment
# variables / secrets in your hosting platform) before deploying with
# jobsite.settings.production. None of the values below are real -- fill
# in your own.
#
# DJANGO_SETTINGS_MODULE must also be set to jobsite.settings.production
# wherever the app actually runs (gunicorn, systemd, your PaaS's env
# vars) -- manage.py and wsgi.py both default to jobsite.settings.dev
# otherwise.

DJANGO_SETTINGS_MODULE=jobsite.settings.production

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated, no scheme, no trailing slash. e.g. example.com,www.example.com
ALLOWED_HOSTS=

# Comma-separated, WITH scheme. e.g. https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# No trailing slash, no '/admin'. Used in emails Wagtail sends outside a
# request (notifications, password reset).
WAGTAILADMIN_BASE_URL=https://example.com

# Set to false only if the site isn't served over HTTPS yet (e.g. while
# DNS/certificates are still being set up).
SECURE_SSL_REDIRECT=true

# SMTP settings for outgoing mail (contact form, password reset, admin
# notifications). Any standard SMTP provider works.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
